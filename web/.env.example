# Copy this file to .env and fill in your values.
# setup.sh will generate this file automatically with a random session password.

# ─── Auth ─────────────────────────────────────────────────────────────────────

# Required: secret used to sign/encrypt session cookies.
# Must be at least 32 characters. Generate with: openssl rand -base64 48
NUXT_SESSION_PASSWORD=change-me-to-a-random-32-char-string

# ─── Database ─────────────────────────────────────────────────────────────────

# SQLite database file path (relative to project root)
DATABASE_PATH=./data/photos.db

# ─── Object Storage (RustFS / S3-compatible) ──────────────────────────────────
# For local development, run RustFS in Docker:
#   docker run -p 9000:9000 -p 9001:9001 rustfs/rustfs server /data
# Then point these vars at that instance.

# Full endpoint URL including protocol and port
STORAGE_ENDPOINT=http://localhost:9000

# Access credentials (set in your RustFS / MinIO admin console)
STORAGE_ACCESS_KEY_ID=your-access-key
STORAGE_SECRET_ACCESS_KEY=your-secret-key

# Bucket to store photos in (must already exist)
STORAGE_BUCKET_NAME=photos

# Region — use any value for self-hosted; most S3 SDKs require something here
STORAGE_REGION=us-east-1

# ─── Storage behaviour ────────────────────────────────────────────────────────

# Maximum number of versions to retain per photo object (0 = versioning disabled)
STORAGE_MAX_VERSIONS=3
